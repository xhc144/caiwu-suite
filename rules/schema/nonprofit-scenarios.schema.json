{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "const": "ContractsV2SpecificationOnly"
    },
    "isProductionCertified": {
      "const": false
    },
    "allAmountsSynthetic": {
      "const": true
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sourceId",
          "locator"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "Ledger",
              "Allocation"
            ]
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId",
                "locator"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "restrictions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceKind": {
                  "enum": [
                    "ExternalProvider",
                    "LawOrAdministrativeRegulation",
                    "InternalBudget"
                  ]
                },
                "evidenceId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "conditions": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "Time",
                      "Purpose"
                    ]
                  },
                  "minItems": 0
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "sourceKind",
                "evidenceId",
                "conditions",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "allocations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "voucherId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "total": {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                },
                "basisApproved": {
                  "type": "boolean"
                },
                "basisEvidenceId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "roundingPolicy": {
                  "const": "LargestRemainderThenRowId"
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "accountCode": {
                        "type": "string",
                        "minLength": 1
                      },
                      "restrictionClass": {
                        "enum": [
                          null,
                          "Restricted",
                          "Unrestricted"
                        ]
                      },
                      "restrictionId": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "weight": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "amount": {
                        "type": "string",
                        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                      }
                    },
                    "required": [
                      "id",
                      "accountCode",
                      "restrictionClass",
                      "restrictionId",
                      "weight",
                      "amount"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "voucherId",
                "total",
                "basisApproved",
                "basisEvidenceId",
                "roundingPolicy",
                "rows"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "vouchers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "Opening",
                    "Activity",
                    "Closing",
                    "Release"
                  ]
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "cashNature": {
                  "enum": [
                    "Cash",
                    "Noncash"
                  ]
                },
                "releaseAssessment": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "restrictionId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "timeSatisfied": {
                          "type": "boolean"
                        },
                        "purposeSatisfied": {
                          "type": "boolean"
                        },
                        "providerRevoked": {
                          "type": "boolean"
                        },
                        "evidenceId": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "minLength": 1
                        }
                      },
                      "required": [
                        "restrictionId",
                        "timeSatisfied",
                        "purposeSatisfied",
                        "providerRevoked",
                        "evidenceId"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "accountCode": {
                        "type": "string",
                        "minLength": 1
                      },
                      "debit": {
                        "type": "string",
                        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                      },
                      "credit": {
                        "type": "string",
                        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                      },
                      "restrictionClass": {
                        "enum": [
                          null,
                          "Restricted",
                          "Unrestricted"
                        ]
                      },
                      "restrictionId": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "accountCode",
                      "debit",
                      "credit",
                      "restrictionClass",
                      "restrictionId"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 2
                }
              },
              "required": [
                "id",
                "kind",
                "date",
                "cashNature",
                "releaseAssessment",
                "lines"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "expected": {
            "type": "object",
            "properties": {
              "errorCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "result": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "metrics": {
                        "type": "object",
                        "properties": {
                          "incomeUnrestricted": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          },
                          "incomeRestricted": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          },
                          "expenseUnrestricted": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          },
                          "expenseRestricted": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          },
                          "cashChange": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          },
                          "releasedToUnrestricted": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          },
                          "releasedFromRestricted": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          },
                          "assets": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          },
                          "liabilities": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          },
                          "unrestrictedNetAssets": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          },
                          "restrictedNetAssets": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          },
                          "totalNetAssets": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          }
                        },
                        "required": [
                          "incomeUnrestricted",
                          "incomeRestricted",
                          "expenseUnrestricted",
                          "expenseRestricted",
                          "cashChange",
                          "releasedToUnrestricted",
                          "releasedFromRestricted",
                          "assets",
                          "liabilities",
                          "unrestrictedNetAssets",
                          "restrictedNetAssets",
                          "totalNetAssets"
                        ],
                        "additionalProperties": false
                      },
                      "incomeExpenseClosingZero": {
                        "const": true
                      },
                      "allocations": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          }
                        }
                      }
                    },
                    "required": [
                      "metrics",
                      "incomeExpenseClosingZero",
                      "allocations"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "allocations": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"
                          }
                        }
                      }
                    },
                    "required": [
                      "allocations"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "errorCode",
              "result"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "assumptions",
          "sourceRefs",
          "restrictions",
          "allocations",
          "vouchers",
          "expected"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "packageId",
    "purpose",
    "isProductionCertified",
    "allAmountsSynthetic",
    "sourceRefs",
    "cases",
    "limitations"
  ],
  "additionalProperties": false
}
