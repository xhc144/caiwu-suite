{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caiwu.invalid/rules/sources.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "documentNumber": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "noticeUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "issuedOn": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "effectiveFrom": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "OfficialCurrent",
              "OfficialFuturePhased",
              "Draft"
            ]
          },
          "retrievedOn": {
            "type": "string",
            "format": "date"
          },
          "localPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "verification": {
            "enum": [
              "OfficialBytesRetrieved",
              "OfficialWebTextRead",
              "OfficialAccessStatementOnly",
              "MetadataOnly"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "title",
          "documentNumber",
          "url",
          "noticeUrl",
          "issuedOn",
          "effectiveFrom",
          "status",
          "retrievedOn",
          "localPath",
          "sha256",
          "bytes",
          "verification",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "researchInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 3
    },
    "researchArchiveSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "researchLocationNote": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "asOf",
    "sources",
    "researchInputs",
    "researchArchiveSha256",
    "researchLocationNote"
  ],
  "additionalProperties": false
}
