{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "regime": {
      "const": "Enterprise"
    },
    "legalStatus": {
      "const": "OfficialCurrent"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "isCompleteCurrentChart": {
      "const": false
    },
    "isVerifiedForProduction": {
      "const": false
    },
    "verifiedNumericCodeCount": {
      "const": 0
    },
    "officialNameCount": {
      "type": "integer",
      "minimum": 1
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sourceId",
          "locator"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "namedAccounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "semanticId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "accountCode": {
            "type": "null"
          },
          "numericCodeVerification": {
            "const": "NotObtainedFromOfficialCurrentGuide"
          },
          "evidenceType": {
            "const": "AccountNameExplicitlyMentionedInFormalReportInstructions"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId",
                "locator"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "normalDirection": {
            "type": "null"
          },
          "normalDirectionVerification": {
            "const": "NotEstablishedByThisNameEvidence"
          },
          "isCompleteCurrentChart": {
            "const": false
          }
        },
        "required": [
          "semanticId",
          "name",
          "accountCode",
          "numericCodeVerification",
          "evidenceType",
          "sourceRefs",
          "normalDirection",
          "normalDirectionVerification",
          "isCompleteCurrentChart"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "formalUpdates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "documentNumber": {
            "type": "string",
            "minLength": 1
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId",
                "locator"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "adoptedByProfile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "DualListedOrSpecifiedOverseas": {
                "type": "string",
                "format": "date"
              },
              "OtherDomesticListed": {
                "type": "string",
                "format": "date"
              },
              "NonfinancialUnlisted": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "earlyAdoption": {
            "type": "string",
            "minLength": 1
          },
          "replaces2006": {
            "type": "string",
            "minLength": 1
          },
          "verifiedNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "numericCodesVerified": {
            "const": false
          },
          "implementation": {
            "const": "MetadataOnly"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "documentNumber",
          "sourceRefs",
          "adoptedByProfile",
          "earlyAdoption",
          "replaces2006",
          "verifiedNames",
          "numericCodesVerified",
          "implementation",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "historicalBase": {
      "type": "object",
      "properties": {
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sourceId",
              "locator"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "original2006ChartRetrieved": {
          "const": false
        },
        "post2014NumberedGuidesRetrieved": {
          "const": false
        },
        "fullSupersessionMatrixValidated": {
          "const": false
        }
      },
      "required": [
        "sourceRefs",
        "original2006ChartRetrieved",
        "post2014NumberedGuidesRetrieved",
        "fullSupersessionMatrixValidated"
      ],
      "additionalProperties": false
    },
    "retrievalAttempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "downloaded": {
            "const": false
          },
          "retryPermitted": {
            "const": false
          }
        },
        "required": [
          "id",
          "url",
          "operation",
          "outcome",
          "downloaded",
          "retryPermitted"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "unverifiedEngineeringSampleCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "asOf",
    "regime",
    "legalStatus",
    "scope",
    "isCompleteCurrentChart",
    "isVerifiedForProduction",
    "verifiedNumericCodeCount",
    "officialNameCount",
    "sourceRefs",
    "namedAccounts",
    "formalUpdates",
    "historicalBase",
    "retrievalAttempts",
    "unverifiedEngineeringSampleCodes",
    "limitations"
  ],
  "additionalProperties": false
}
