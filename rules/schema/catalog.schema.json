{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caiwu.invalid/rules/catalog.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "regime": {
            "enum": [
              "SmallBusiness",
              "Enterprise",
              "Nonprofit"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "OfficialCurrent",
              "OfficialFuturePhased",
              "Draft"
            ]
          },
          "selectable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "regime",
          "path",
          "sha256",
          "status",
          "selectable"
        ],
        "additionalProperties": false
      },
      "minItems": 3
    },
    "enterprisePresentationChange": {
      "type": "object",
      "properties": {
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sourceId",
              "locator"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "officialNoticeUrl": {
          "type": "string",
          "minLength": 1
        },
        "earlyAdoptionAllowed": {
          "const": true
        },
        "earliestKnownPublicationDate": {
          "type": "string",
          "format": "date"
        },
        "newRulesImplemented": {
          "const": false
        },
        "mandatoryFrom": {
          "type": "object",
          "properties": {
            "DualListedOrSpecifiedOverseas": {
              "type": "string",
              "format": "date"
            },
            "OtherDomesticListed": {
              "type": "string",
              "format": "date"
            },
            "NonfinancialUnlisted": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "DualListedOrSpecifiedOverseas",
            "OtherDomesticListed",
            "NonfinancialUnlisted"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sourceRefs",
        "officialNoticeUrl",
        "earlyAdoptionAllowed",
        "earliestKnownPublicationDate",
        "newRulesImplemented",
        "mandatoryFrom"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "asOf",
    "entries",
    "enterprisePresentationChange",
    "limitations"
  ],
  "additionalProperties": false
}
