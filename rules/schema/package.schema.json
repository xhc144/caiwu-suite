{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caiwu.invalid/rules/package.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "regime": {
      "enum": [
        "SmallBusiness",
        "Enterprise",
        "Nonprofit"
      ]
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "legalStatus": {
      "enum": [
        "OfficialCurrent"
      ]
    },
    "legalEffectiveFrom": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "supportedPeriodsFrom": {
      "type": "string",
      "format": "date"
    },
    "effectiveUntil": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "isVerifiedForProduction": {
      "const": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "includedProfiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "requiresHumanEligibilityReview": {
          "const": true
        }
      },
      "required": [
        "description",
        "includedProfiles",
        "exclusions",
        "requiresHumanEligibilityReview"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "firstLevelAccounts": {
          "enum": [
            "CompleteOfficialBaseSnapshot",
            "EngineeringExamplesOnly"
          ]
        },
        "officialBaseCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "allCurrentRequirementsCovered": {
          "const": false
        },
        "reports": {
          "enum": [
            "MetadataOnly",
            "MetadataAndRepresentativeRows"
          ]
        },
        "migration": {
          "enum": [
            "Unsupported",
            "PartialEvidenceOnly"
          ]
        }
      },
      "required": [
        "firstLevelAccounts",
        "officialBaseCount",
        "allCurrentRequirementsCovered",
        "reports",
        "migration"
      ],
      "additionalProperties": false
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sourceId",
          "locator"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{4}(?:[0-9]{2}){0,4}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parentCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "enum": [
              "Asset",
              "Liability",
              "Equity",
              "NetAssets",
              "Cost",
              "Income",
              "Expense"
            ]
          },
          "normalDirection": {
            "enum": [
              "Debit",
              "Credit"
            ]
          },
          "normalDirectionIsExclusive": {
            "const": false
          },
          "nameVerification": {
            "enum": [
              "OfficialTable",
              "OfficialReportText",
              "UnverifiedEngineeringExample"
            ]
          },
          "isContra": {
            "type": "boolean"
          },
          "origin": {
            "enum": [
              "OfficialFirstLevel",
              "EngineeringExampleCode",
              "LocalDetail"
            ]
          },
          "ordinal": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "restrictionPolicy": {
            "enum": [
              "NotApplicable",
              "Required",
              "ReviewRequired"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId",
                "locator"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "officialBaseName": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "parentCode",
          "category",
          "normalDirection",
          "normalDirectionIsExclusive",
          "nameVerification",
          "isContra",
          "origin",
          "ordinal",
          "restrictionPolicy",
          "sourceRefs",
          "notes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "officialForm": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "periods": {
            "type": "array",
            "items": {
              "enum": [
                "Monthly",
                "Interim",
                "Annual"
              ]
            },
            "minItems": 1
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "coverage": {
            "enum": [
              "MetadataOnly",
              "MetadataAndRepresentativeRows"
            ]
          },
          "isCompleteFormulaSet": {
            "const": false
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId",
                "locator"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "officialRowNumber": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "terms": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "accountCode": {
                        "type": "string",
                        "minLength": 1
                      },
                      "measure": {
                        "enum": [
                          "closing_net_debit",
                          "period_net_debit"
                        ]
                      },
                      "coefficient": {
                        "enum": [
                          -1,
                          1
                        ]
                      }
                    },
                    "required": [
                      "accountCode",
                      "measure",
                      "coefficient"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "restrictionColumns": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "Unrestricted",
                      "Restricted"
                    ]
                  },
                  "minItems": 0
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sourceId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "sourceId",
                      "locator"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                }
              },
              "required": [
                "id",
                "label",
                "officialRowNumber",
                "terms",
                "restrictionColumns",
                "sourceRefs",
                "limitations"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "columnVariants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "period": {
                  "enum": [
                    "Monthly",
                    "Quarterly",
                    "HalfYearly",
                    "Annual"
                  ]
                },
                "status": {
                  "enum": [
                    "DefinedMetadata",
                    "UnimplementedPresentation"
                  ]
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sourceId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "sourceId",
                      "locator"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "period",
                "status",
                "columns",
                "sourceRefs"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "officialForm",
          "title",
          "periods",
          "columns",
          "coverage",
          "isCompleteFormulaSet",
          "sourceRefs",
          "rows",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "restrictionRules": {
      "type": "object",
      "properties": {
        "dimensionValues": {
          "const": [
            "Unrestricted",
            "Restricted"
          ]
        },
        "inventedSubaccountCodes": {
          "const": false
        },
        "evidenceRequiredForRestricted": {
          "const": [
            "ExternalProvider",
            "LawOrAdministrativeRegulation"
          ]
        },
        "internalBudgetAloneQualifies": {
          "const": false
        },
        "restrictedSpendingAutomaticallyReclassifiesNetAssets": {
          "const": false
        },
        "closingTargets": {
          "type": "object",
          "properties": {
            "Unrestricted": {
              "type": "string",
              "minLength": 1
            },
            "Restricted": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "Unrestricted",
            "Restricted"
          ],
          "additionalProperties": false
        },
        "manualReviewAccounts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sourceId",
              "locator"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "dimensionValues",
        "inventedSubaccountCodes",
        "evidenceRequiredForRestricted",
        "internalBudgetAloneQualifies",
        "restrictedSpendingAutomaticallyReclassifiesNetAssets",
        "closingTargets",
        "manualReviewAccounts",
        "sourceRefs"
      ],
      "additionalProperties": false
    },
    "firstAdoptionComparatives": {
      "type": "object",
      "properties": {
        "year": {
          "const": 2026
        },
        "openingBalanceSheetDate": {
          "type": "string",
          "format": "date"
        },
        "activityAndCashflowPriorYearRequired": {
          "const": false
        },
        "missingValueMeaning": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sourceId",
              "locator"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "year",
        "openingBalanceSheetDate",
        "activityAndCashflowPriorYearRequired",
        "missingValueMeaning",
        "sourceRefs"
      ],
      "additionalProperties": false
    },
    "officialNameEvidencePath": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "regime",
    "displayName",
    "legalStatus",
    "legalEffectiveFrom",
    "supportedPeriodsFrom",
    "effectiveUntil",
    "isVerifiedForProduction",
    "scope",
    "coverage",
    "sourceRefs",
    "accounts",
    "reports",
    "limitations"
  ],
  "additionalProperties": false
}
