<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CaiwuSourceRoot Condition="'$(CaiwuSourceRoot)' == ''">../../..</CaiwuSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CaiwuSourceRoot)/src/Caiwu.Core/Caiwu.Core.csproj" />
    <ProjectReference Include="$(CaiwuSourceRoot)/src/Caiwu.Persistence.Sqlite/Caiwu.Persistence.Sqlite.csproj" />
  </ItemGroup>
</Project>
