<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CoreProject Condition="'$(CoreProject)' == ''">../../../src/Caiwu.Core/Caiwu.Core.csproj</CoreProject>
    <SqliteProject Condition="'$(SqliteProject)' == ''">../../../src/Caiwu.Persistence.Sqlite/Caiwu.Persistence.Sqlite.csproj</SqliteProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CoreProject)" />
    <ProjectReference Include="$(SqliteProject)" />
  </ItemGroup>
</Project>
