<Window x:Class="Caiwu.Summaries.Wpf.SummaryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="摘要库 · 管理与选择" Width="1080" Height="720" MinWidth="850" MinHeight="580"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="摘要库" FontSize="24" FontWeight="SemiBold" />
      <TextBlock x:Name="BookScope" Margin="0,6,0,0" TextWrapping="Wrap">
        <Run Text="当前账套：" /><Run Text="{Binding BookDisplayName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding BookId, Mode=OneWay}" />
      </TextBlock>
      <TextBlock Margin="0,4,0,0" Text="分类和摘要仅用于当前账套。切换账套后请重新打开摘要库。"
                 Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="分类" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Button x:Name="AllCategoriesButton" Grid.Row="1" Content="查看全部分类" Padding="10,6" Margin="0,0,0,8"
                IsEnabled="{Binding CanBrowse}" Click="AllCategories_Click" />
        <ListBox x:Name="CategoryList" Grid.Row="2" DisplayMemberPath="Name" SelectedValuePath="Id"
                 SelectionChanged="CategoryList_SelectionChanged" IsEnabled="{Binding CanBrowse}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="摘要分类" />
        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
          <Button x:Name="AddCategoryButton" Content="新增分类" Padding="8,6" Margin="0,0,6,6" IsEnabled="{Binding CanStartEdit}" Click="AddCategory_Click" />
          <Button x:Name="RenameCategoryButton" Content="改名" Padding="8,6" Margin="0,0,6,6" IsEnabled="{Binding CanEditCategory}" Click="RenameCategory_Click" />
          <Button x:Name="DeleteCategoryButton" Content="删除" Padding="8,6" Margin="0,0,0,6" IsEnabled="{Binding CanEditCategory}" Click="DeleteCategory_Click" />
        </WrapPanel>
      </Grid>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="摘要" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
          <Label Content="搜索分类或摘要" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,6" />
          <TextBox x:Name="SearchBox" Padding="8,6"
                   Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBrowse}"
                   AutomationProperties.Name="搜索分类或摘要" ToolTip="搜索分类或正文；多个词用空格分隔" />
        </StackPanel>
        <DataGrid x:Name="SummaryList" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                  SelectedValuePath="Id" SelectionChanged="SummaryList_SelectionChanged" IsEnabled="{Binding CanBrowse}"
                  HeadersVisibility="Column" RowHeight="38" GridLinesVisibility="None" AutomationProperties.Name="摘要列表">
          <DataGrid.Columns>
            <DataGridTextColumn Header="分类" Binding="{Binding CategoryName}" Width="100" />
            <DataGridTextColumn Header="摘要内容" Binding="{Binding Text}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
          <Button x:Name="AddSummaryButton" Content="新增摘要" Padding="10,6" Margin="0,0,6,6" IsEnabled="{Binding CanAddSummary}" Click="AddSummary_Click" />
          <Button x:Name="EditSummaryButton" Content="编辑" Padding="10,6" Margin="0,0,6,6" IsEnabled="{Binding CanEditSummary}" Click="EditSummary_Click" />
          <Button x:Name="DeleteSummaryButton" Content="删除" Padding="10,6" Margin="0,0,0,6" IsEnabled="{Binding CanEditSummary}" Click="DeleteSummary_Click" />
        </WrapPanel>
      </Grid>
      <Border Grid.Column="4" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="8" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="{Binding EditHeading}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
            <StackPanel Visibility="{Binding IsCategoryEditor, Converter={StaticResource VisibleWhenTrue}}">
              <Label Content="分类名称" Target="{Binding ElementName=CategoryNameBox}" Padding="0,0,0,6" />
              <TextBox x:Name="CategoryNameBox" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="8,6" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsSummaryEditor, Converter={StaticResource VisibleWhenTrue}}">
              <Label Content="所属分类" Target="{Binding ElementName=EntryCategoryBox}" Padding="0,0,0,6" />
              <ComboBox x:Name="EntryCategoryBox" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                        SelectedValue="{Binding DraftCategoryId, Mode=TwoWay}" Margin="0,0,0,12" />
              <Label Content="摘要内容" Target="{Binding ElementName=SummaryTextBox}" Padding="0,0,0,6" />
              <TextBox x:Name="SummaryTextBox" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                       TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="190" MaxLength="4000" Padding="8" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsDeleteEditor, Converter={StaticResource VisibleWhenTrue}}">
              <TextBlock Text="即将删除以下内容。删除分类前必须先移走或删除其摘要。" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBox x:Name="DeletePreview" Text="{Binding DraftText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="190" VerticalScrollBarVisibility="Auto" Padding="8" />
            </StackPanel>
            <StackPanel Visibility="{Binding HasPendingEdit, Converter={StaticResource VisibleWhenTrue}}" Margin="0,12,0,0">
              <TextBlock Text="尚未保存" Margin="0,0,0,8" FontWeight="SemiBold" />
              <Button x:Name="SaveButton" Content="{Binding SaveButtonText}" Padding="12,8" IsEnabled="{Binding CanSave}" Click="Save_Click" />
              <Button x:Name="CancelEditButton" Content="取消本次编辑" Padding="10,6" Margin="0,8,0,0" Click="CancelEdit_Click" />
            </StackPanel>
            <TextBlock Text="选中摘要预览" Margin="0,20,0,8" FontWeight="SemiBold" />
            <TextBox x:Name="SelectedPreview" Text="{Binding SelectedEntry.Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MinHeight="90" MaxHeight="200" Padding="8" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,14,0,12">
      <TextBlock x:Name="StatusMessage" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Margin="0,6,0,0" Text="仅“保存更改 / 确认删除并保存”写入摘要库。取消或关闭会丢弃未保存编辑，已保存的更改保留。"
                 TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    </StackPanel>
    <DockPanel Grid.Row="3" LastChildFill="False">
      <Button x:Name="ReloadButton" DockPanel.Dock="Left" Content="重新载入" Padding="12,8" IsEnabled="{Binding CanRefresh}" Click="Reload_Click"
              ToolTip="编辑期间不能重新载入；请先保存或取消编辑。冲突时先复制需要保留的输入，再取消编辑并重新载入核对。" />
      <Button x:Name="CancelWindowButton" DockPanel.Dock="Right" Content="取消选择并关闭" Padding="14,8" Click="CancelWindow_Click" />
      <Button x:Name="ChooseButton" DockPanel.Dock="Right" Content="使用选中摘要" Padding="14,8" Margin="0,0,10,0" IsEnabled="{Binding CanAccept}" Click="Choose_Click" />
    </DockPanel>
  </Grid>
</Window>
