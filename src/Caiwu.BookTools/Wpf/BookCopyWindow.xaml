<Window x:Class="Caiwu.BookTools.Wpf.BookCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="复制为新账套" Width="790" Height="740" MinWidth="670" MinHeight="600"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="Inputs">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="复制为新账套"/>
            <TextBlock Margin="0,8,0,14" TextWrapping="Wrap" Text="创建独立新身份。请先保存或取消原窗口中的编辑；恢复原身份副本请使用备份恢复。"/>
            <TextBlock Text="源账套（已保存快照）"/>
            <TextBlock x:Name="SourceText" Margin="0,3,0,10" TextWrapping="Wrap"/>
            <TextBlock Text="新账套名称"/>
            <TextBox Margin="0,3,0,10" Text="{Binding NewBookName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="新文件路径（.caiwu，不可覆盖）"/>
            <DockPanel Margin="0,3,0,10">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,3" Content="选择…" Click="Browse_Click"/>
                <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <TextBlock Text="操作人（用于复制来源审计）"/>
            <TextBox Margin="0,3,0,10" Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="复制范围"/>
            <ComboBox x:Name="ScopeBox" Margin="0,3,0,10" SelectedIndex="0" SelectionChanged="Scope_Changed">
                <ComboBoxItem Content="结构化全量：科目、原始期初、凭证、审计及结账状态"/>
                <ComboBoxItem Content="仅科目及原始期初：不含凭证，尚未结账"/>
            </ComboBox>
            <Button HorizontalAlignment="Left" Padding="16,5" Content="生成复制前预览" Click="Preview_Click"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap"/>
        </ScrollViewer>
        <StackPanel Grid.Row="2">
            <CheckBox x:Name="Confirmation" Content="我已核对本次预览，明确同意创建这个新身份账套。"
                      IsChecked="{Binding Confirmed, Mode=TwoWay}" IsEnabled="False" Margin="0,0,0,10"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ExecuteButton" Content="确认复制" Padding="18,6" IsEnabled="False" Click="Execute_Click"/>
                <Button x:Name="CancelButton" Content="取消" Padding="18,6" Margin="10,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
