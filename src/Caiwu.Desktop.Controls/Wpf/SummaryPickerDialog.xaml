<Window x:Class="Caiwu.Desktop.Controls.SummaryPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择常用摘要" Width="860" Height="570" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="#F5F7FB" Foreground="#172B45" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Caiwu.Desktop.Controls;component/Wpf/PickerStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,13"><TextBlock Text="选择常用摘要" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="选择分类后查找摘要，确认后填入当前分录。" Foreground="#61718A" Margin="0,5,0,0"/></StackPanel>
    <TextBox x:Name="SummarySearch" Grid.Row="1" Margin="0,0,0,12" AutomationProperties.AutomationId="SummarySearch" AutomationProperties.Name="搜索摘要分类或内容" TextChanged="Search_Changed"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="SummaryCategories" AutomationProperties.AutomationId="SummaryCategories" AutomationProperties.Name="摘要分类" BorderBrush="#D8E1ED" BorderThickness="1" SelectionChanged="Category_Changed"/>
      <DataGrid x:Name="SummaryList" Grid.Column="2" AutomationProperties.AutomationId="SummaryList" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick" RowHeight="36">
        <DataGrid.Columns><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="115"/>
          <DataGridTextColumn Header="常用摘要" Binding="{Binding Text}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <TextBox x:Name="SummaryPreview" Grid.Row="3" Margin="0,10,0,0" Height="64" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="选中摘要完整预览"/>
    <TextBlock x:Name="SelectionStatus" Grid.Row="4" Margin="0,9,0,9" TextWrapping="Wrap" Foreground="#61718A" AutomationProperties.LiveSetting="Polite"/>
    <Grid Grid.Row="5"><TextBlock Text="↑ ↓ 选择摘要    Enter 确认    Esc 取消" Foreground="#61718A" VerticalAlignment="Center" FontSize="12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Margin="0,0,8,0"/>
        <Button x:Name="ChooseButton" AutomationProperties.AutomationId="ChooseSummary" Content="选择" Click="Choose_Click" Style="{StaticResource PickerPrimaryButton}"/></StackPanel>
    </Grid>
  </Grid>
</Window>
