<Window x:Class="Caiwu.Desktop.Controls.AccountPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Caiwu.Desktop.Controls"
        Title="选择会计科目" Width="880" Height="570" MinWidth="680" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="#F5F7FB" Foreground="#172B45" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Caiwu.Desktop.Controls;component/Wpf/PickerStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,13"><TextBlock Text="选择会计科目" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="按代码或名称查找，选择启用的末级科目。" Foreground="#61718A" Margin="0,5,0,0"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="AccountSearch" AutomationProperties.AutomationId="AccountSearch" AutomationProperties.Name="搜索科目代码或名称" TextChanged="Search_Changed" ToolTip="搜索代码、名称；空格分隔多个条件"/>
      <CheckBox x:Name="OnlySelectable" Grid.Column="1" Content="仅可选明细" Margin="15,0,0,0" VerticalAlignment="Center" Checked="OnlySelectable_Changed" Unchecked="OnlySelectable_Changed"/>
    </Grid>
    <TabControl x:Name="AccountsView" Grid.Row="2" BorderThickness="0" Background="Transparent" SelectionChanged="View_Changed">
      <TabItem Header="科目列表"><DataGrid x:Name="AccountList" AutomationProperties.AutomationId="AccountList" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick">
        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding IsSelectable}" Value="False"><Setter Property="Foreground" Value="#7A879B"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
        <DataGrid.Columns><DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="160"/><DataGridTextColumn Header="科目名称" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="选择状态" Binding="{Binding SelectionHint}" Width="240"/></DataGrid.Columns>
      </DataGrid></TabItem>
      <TabItem Header="科目树"><TreeView x:Name="AccountTree" AutomationProperties.AutomationId="AccountTree" BorderBrush="#D8E1ED" BorderThickness="1" Background="White" SelectedItemChanged="Tree_SelectionChanged" MouseDoubleClick="Tree_DoubleClick">
        <TreeView.ItemTemplate><HierarchicalDataTemplate DataType="{x:Type local:AccountTreeNode}" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Choice.Code}" MinWidth="125"/>
            <TextBlock Text="{Binding Choice.Name}" Margin="6,0,12,0"/><TextBlock Text="{Binding Choice.SelectionHint}" Foreground="#61718A" FontSize="12"/></StackPanel>
        </HierarchicalDataTemplate></TreeView.ItemTemplate>
      </TreeView></TabItem>
    </TabControl>
    <TextBlock x:Name="SelectionStatus" Grid.Row="3" Margin="0,10,0,9" TextWrapping="Wrap" Foreground="#61718A" AutomationProperties.LiveSetting="Polite"/>
    <Grid Grid.Row="4"><TextBlock Text="↑ ↓ 选择明细    Enter 确认    Esc 取消" Foreground="#61718A" VerticalAlignment="Center" FontSize="12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Margin="0,0,8,0"/>
        <Button x:Name="ChooseButton" AutomationProperties.AutomationId="ChooseAccount" Content="选择" Click="Choose_Click" Style="{StaticResource PickerPrimaryButton}"/></StackPanel>
    </Grid>
  </Grid>
</Window>
