<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- A multi-target outer restore runs before Microsoft.Common.targets imports. -->
  <PropertyGroup Condition="'$(DeliveryLockGraph)' != ''">
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)../../packaging-next/locks/$(DeliveryLockGraph)/Caiwu.Desktop.Controls.packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Caiwu.Contracts/Caiwu.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Wpf/**/*.cs" />
    <None Remove="Wpf/**/*.xaml" />
  </ItemGroup>
</Project>
