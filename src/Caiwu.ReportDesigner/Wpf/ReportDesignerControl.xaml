<UserControl x:Class="Caiwu.ReportDesigner.Wpf.ReportDesignerControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 MinWidth="720" MinHeight="560" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10"><TextBlock Text="报表模板设计" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <WrapPanel HorizontalAlignment="Right"><Button x:Name="LoadButton" Content="载入模板" Click="Load_Click" Margin="4" Padding="12,6"/><Button x:Name="SaveButton" Content="保存模板" Click="Save_Click" Margin="4" Padding="12,6"/><Button x:Name="PreviewButton" Content="重新预览" Click="Preview_Click" Margin="4" Padding="12,6"/><Button x:Name="HtmlButton" Content="导出 HTML" Click="Html_Click" IsEnabled="False" Margin="4" Padding="12,6"/><Button x:Name="CsvButton" Content="导出 CSV" Click="Csv_Click" IsEnabled="False" Margin="4" Padding="12,6"/><Button x:Name="PrintButton" Content="Windows 打印" Click="Print_Click" IsEnabled="False" Margin="4" Padding="12,6"/></WrapPanel>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="160"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,8,8"><TextBlock Text="标题"/><TextBox x:Name="TitleEditor" TextChanged="Edited" MaxLength="160"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,8,8"><TextBlock Text="每页页眉（纯文本）"/><TextBox x:Name="HeaderEditor" TextChanged="Edited" MaxLength="500"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="0,0,8,8"><TextBlock Text="A4方向"/><ComboBox x:Name="OrientationEditor" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="SelectionEdited"/></StackPanel>
   <StackPanel Grid.Column="3" Margin="0,0,8,8"><TextBlock Text="按来源文本字段分组小计"/><ComboBox x:Name="GroupEditor" DisplayMemberPath="Title" SelectedValuePath="Key" SelectionChanged="SelectionEdited"/></StackPanel>
   <StackPanel Grid.Column="4" Margin="0,0,0,8"><TextBlock Text="每逻辑页行数"/><TextBox x:Name="PageRowsEditor" TextChanged="Edited"/></StackPanel>
  </Grid>
  <WrapPanel Grid.Row="2" Margin="0,0,0,8" VerticalAlignment="Center">
   <TextBlock Text="已知字段 " VerticalAlignment="Center"/><ComboBox x:Name="FieldPicker" Width="175" DisplayMemberPath="Title"/>
   <Button Content="添加字段列" Click="AddField_Click" Margin="5,0" Padding="10,4"/>
   <Button Content="添加计算列" Click="AddFormula_Click" Margin="5,0" Padding="10,4"/>
   <Button Content="上移" Click="Up_Click" Margin="5,0" Padding="10,4"/><Button Content="下移" Click="Down_Click" Margin="5,0" Padding="10,4"/><Button Content="删除列" Click="Remove_Click" Margin="5,0" Padding="10,4"/>
   <TextBlock Text="预览数据行上限 " VerticalAlignment="Center"/><TextBox x:Name="LimitEditor" Text="200" Width="70" TextChanged="Edited"/>
  </WrapPanel>
  <DataGrid Grid.Row="3" x:Name="ColumnEditor" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeight="48" GridLinesVisibility="Horizontal" CellEditEnding="ColumnCellEditEnding">
   <DataGrid.Columns>
    <DataGridTextColumn Header="列键" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="115"/>
    <DataGridTextColumn Header="标题" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
    <DataGridTextColumn Header="字段 / decimal公式" Binding="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="180"/>
    <DataGridTextColumn Header="宽度DIP" Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
    <DataGridTemplateColumn Header="格式" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridCheckBoxColumn Header="显示" Binding="{Binding Visible, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
    <DataGridCheckBoxColumn Header="求和" Binding="{Binding Total, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="4" Margin="0,8"><TextBlock Text="公式例：[periodDebit]-[periodCredit]；ROUND([debit]/3,2)；SUM([debit],-[credit])。函数仅同行；汇总由求和列产生。" TextWrapping="Wrap"/>
   <TextBox x:Name="AuditText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" MaxHeight="135" VerticalScrollBarVisibility="Auto"/>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4"/>
  </StackPanel>
  <TabControl Grid.Row="5">
   <TabItem Header="数据预览"><DataGrid x:Name="PreviewGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinRowHeight="28"/></TabItem>
   <TabItem Header="A4 页面预览"><FlowDocumentPageViewer x:Name="PagePreview"/></TabItem>
  </TabControl>
 </Grid>
</UserControl>
