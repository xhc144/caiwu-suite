<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- The pinned baseline has no parity contract. Activate only with the integrator-owned actual contract file. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../Caiwu.Contracts/ParityModules.cs')">
    <DefineConstants>$(DefineConstants);CAIWU_PARITY_MODULES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Wpf/**/*.cs" />
    <ProjectReference Include="../Caiwu.Contracts/Caiwu.Contracts.csproj" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="[10.0.13]" />
  </ItemGroup>
</Project>
