<Window x:Class="Caiwu.Operators.Wpf.ChangePasswordWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="修改本地密码" Width="450" Height="420" MinWidth="400" MinHeight="400">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="修改后需要重新登录" FontSize="20" Margin="0,0,0,12"/>
   <Label Content="当前密码" Target="{Binding ElementName=CurrentInput}"/><PasswordBox x:Name="CurrentInput" MaxLength="128"/>
   <Label Content="新密码（12–128个字符）" Target="{Binding ElementName=PasswordInput}"/><PasswordBox x:Name="PasswordInput" MaxLength="128"/>
   <Label Content="再次输入新密码" Target="{Binding ElementName=ConfirmInput}"/><PasswordBox x:Name="ConfirmInput" MaxLength="128"/>
   <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button x:Name="SaveButton" Content="修改密码" IsDefault="True" Click="Save_Click" MinWidth="90" Margin="0,0,8,0"/>
   <Button Content="取消" IsCancel="True" MinWidth="80"/>
  </StackPanel>
 </Grid>
</Window>
