<Window x:Class="Caiwu.Operators.Wpf.FirstUseWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="首次设置本地管理员" Width="490" Height="565" MinWidth="440" MinHeight="530">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="创建首位管理员" FontSize="20" Margin="0,0,0,12"/>
   <TextBlock Text="账户只在本机用户数据目录保存。请自行设置密码；本软件没有默认生产密码。管理员管理账户，账务权限需要另行分配。" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <Label Content="登录名（3–64位字母、数字、点、下划线、短横线）" Target="{Binding ElementName=LoginInput}"/><TextBox x:Name="LoginInput" MaxLength="64"/>
   <Label Content="显示名" Target="{Binding ElementName=DisplayInput}"/><TextBox x:Name="DisplayInput" MaxLength="80"/>
   <Label Content="密码（12–128个字符）" Target="{Binding ElementName=PasswordInput}"/><PasswordBox x:Name="PasswordInput" MaxLength="128"/>
   <Label Content="再次输入密码" Target="{Binding ElementName=ConfirmInput}"/><PasswordBox x:Name="ConfirmInput" MaxLength="128"/>
   <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button x:Name="SaveButton" Content="创建管理员" IsDefault="True" Click="Save_Click" MinWidth="110" Margin="0,0,8,0"/>
   <Button Content="取消" IsCancel="True" MinWidth="80"/>
  </StackPanel>
 </Grid>
</Window>
