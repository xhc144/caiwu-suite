<Window x:Class="Caiwu.Operators.Wpf.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="操作员登录" Width="440" Height="360" MinWidth="400" MinHeight="340" ResizeMode="CanResize">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="使用本机操作员账户登录" FontSize="20" Margin="0,0,0,18"/>
  <StackPanel Grid.Row="1"><Label Content="登录名" Target="{Binding ElementName=LoginInput}"/><TextBox x:Name="LoginInput" MaxLength="64" AutomationProperties.AutomationId="OperatorLoginName"/></StackPanel>
  <StackPanel Grid.Row="2" Margin="0,8,0,0"><Label Content="密码" Target="{Binding ElementName=PasswordInput}"/><PasswordBox x:Name="PasswordInput" MaxLength="128" AutomationProperties.AutomationId="OperatorLoginPassword"/></StackPanel>
  <TextBlock Grid.Row="3" x:Name="ErrorText" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="LoginButton" Content="登录" IsDefault="True" Click="Login_Click" MinWidth="80" Margin="0,0,8,0"/>
   <Button Content="取消" IsCancel="True" MinWidth="80"/>
  </StackPanel>
 </Grid>
</Window>
