<Window x:Class="Caiwu.AccountingExtensions.Wpf.ReversePostingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="反过账" Width="500" Height="370" MinWidth="450" MinHeight="330"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
 <!-- Coordinates are original PBU proportions in an abstract canvas, not a PBU/DIP conversion. -->
 <Viewbox Stretch="Uniform">
  <Canvas Width="1280" Height="844" TextElement.FontSize="42">
   <TextBlock Canvas.Left="46" Canvas.Top="52" Width="1189" Height="156" TextWrapping="Wrap"
    Text="将取消所选期间的过账，保留凭证及审核信息。" AutomationProperties.AutomationId="st_4"/>
   <TextBox x:Name="YearBox" Canvas.Left="315" Canvas.Top="260" Width="306" Height="80"
    AutomationProperties.AutomationId="em_nf" VerticalContentAlignment="Center" TabIndex="10"/>
   <TextBlock Canvas.Left="649" Canvas.Top="264" Width="229" Height="72" Text="会计年度" AutomationProperties.AutomationId="st_12"/>
   <CheckBox x:Name="AllMonthsBox" Canvas.Left="160" Canvas.Top="356" Width="969" Height="80"
    Content="取消本会计年度所有月份的过账" AutomationProperties.AutomationId="cbx_1"/>
   <TextBlock Canvas.Left="37" Canvas.Top="480" Width="379" Height="72" Text="月份：从" AutomationProperties.AutomationId="st_1"/>
   <TextBox x:Name="FromMonthBox" Canvas.Left="443" Canvas.Top="476" Width="201" Height="80"
    AutomationProperties.AutomationId="em_1" VerticalContentAlignment="Center" TabIndex="20"/>
   <TextBlock Canvas.Left="681" Canvas.Top="476" Width="78" Height="80" Text="到" AutomationProperties.AutomationId="st_3"/>
   <TextBox x:Name="ThroughMonthBox" Canvas.Left="791" Canvas.Top="476" Width="187" Height="80"
    AutomationProperties.AutomationId="em_2" VerticalContentAlignment="Center" TabIndex="30"/>
   <TextBlock Canvas.Left="987" Canvas.Top="476" Width="91" Height="80" Text="月" AutomationProperties.AutomationId="st_5"/>
   <Button x:Name="ConfirmButton" Canvas.Left="265" Canvas.Top="624" Width="251" Height="96"
    Content="确定" AutomationProperties.AutomationId="cb_1" Click="Confirm_Click" TabIndex="40"/>
   <Button Canvas.Left="690" Canvas.Top="624" Width="251" Height="96" Content="取消"
    AutomationProperties.AutomationId="cb_2" Click="Cancel_Click" TabIndex="50"/>
  </Canvas>
 </Viewbox>
</Window>
