<Window x:Class="Caiwu.AccountingExtensions.Wpf.ReopenPeriodWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="反结账" Width="480" Height="340" MinWidth="430" MinHeight="300"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
 <Viewbox Stretch="Uniform">
  <Canvas Width="1166" Height="740" TextElement.FontSize="42">
   <TextBlock Canvas.Left="283" Canvas.Top="40" Width="567" Height="124" Text="提  示" AutomationProperties.AutomationId="st_4" TextAlignment="Center"/>
   <TextBlock Canvas.Left="55" Canvas.Top="240" Width="407" Height="88" Text="本功能将取消" AutomationProperties.AutomationId="st_2"/>
   <TextBlock x:Name="PeriodLabel" Canvas.Left="453" Canvas.Top="240" Width="375" Height="88"
    AutomationProperties.AutomationId="st_jzyf"/>
   <TextBlock Canvas.Left="855" Canvas.Top="240" Width="247" Height="88" Text="的结账" AutomationProperties.AutomationId="st_1"/>
   <CheckBox x:Name="AllMonthsBox" Canvas.Left="73" Canvas.Top="356" Width="969" Height="80"
    Content="取消本会计年度所有月份的结账" AutomationProperties.AutomationId="cbx_1"/>
   <Button x:Name="ConfirmButton" Canvas.Left="201" Canvas.Top="500" Width="283" Height="96"
    Content="确定" AutomationProperties.AutomationId="cb_1" Click="Confirm_Click" TabIndex="10"/>
   <Button Canvas.Left="626" Canvas.Top="500" Width="283" Height="96" Content="取消"
    AutomationProperties.AutomationId="cb_2" Click="Cancel_Click" TabIndex="20"/>
  </Canvas>
 </Viewbox>
</Window>
