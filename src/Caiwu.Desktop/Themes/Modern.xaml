<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <!-- Keep Microsoft's complete editing, calendar, menu and accessibility templates. -->
    <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="AppCanvas" Color="#F2F5FA" />
  <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AppInk" Color="#182B45" />
  <SolidColorBrush x:Key="AppMuted" Color="#596B82" />
  <SolidColorBrush x:Key="AppLine" Color="#DAE3EE" />
  <SolidColorBrush x:Key="AppAccent" Color="#2463D4" />
  <SolidColorBrush x:Key="AppAccentSoft" Color="#EAF1FF" />
  <Style x:Key="KeyboardFocusRing">
    <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Border Margin="-3" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AppAccent}" />
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource AppInk}" />
    <Setter Property="Background" Value="{DynamicResource AppCanvas}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <!-- A complete Button template avoids a silent Aero fallback when a local Style is used. -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource AppSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource AppInk}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
        <Border x:Name="Interaction" CornerRadius="6" Background="#182B45" Opacity="0" IsHitTestVisible="False" />
        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        <Border x:Name="Focus" CornerRadius="6" BorderBrush="{DynamicResource AppAccent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Interaction" Property="Opacity" Value="0.05" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Interaction" Property="Opacity" Value="0.12" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="IsDefaulted" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppAccent}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Label" Property="Opacity" Value="0.46"/><Setter TargetName="Frame" Property="Opacity" Value="0.5" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource AppAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- BasedOn is essential: setters alone replace the implicit Fluent style. -->
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,6"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppLine}" />
    <Setter Property="Foreground" Value="{DynamicResource AppInk}" />
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,6"/>
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
    <Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Language" Value="zh-CN"/><Setter Property="SelectedDateFormat" Value="Short" />
  </Style>
  <Style TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}">
    <Setter Property="Background" Value="{DynamicResource AppSurface}"/><Setter Property="Padding" Value="14,5" />
  </Style>
  <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
    <Setter Property="Padding" Value="12,7"/>
  </Style>
  <Style TargetType="ToolBar" BasedOn="{StaticResource {x:Type ToolBar}}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0" />
    <Setter Property="ToolBarTray.IsLocked" Value="True"/>
    <Style.Resources>
      <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
    </Style.Resources>
  </Style>
  <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
    <Setter Property="Background" Value="{DynamicResource AppSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppLine}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
      <Grid KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="0,0,0,12" KeyboardNavigation.TabIndex="1" />
        <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2" />
        </Border>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
    <Setter Property="Foreground" Value="{DynamicResource AppMuted}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="19,10"/><Setter Property="Margin" Value="0,0,5,0"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
        <ContentPresenter x:Name="ContentSite" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#E8EDF5"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AppAccentSoft}"/><Setter TargetName="Frame" Property="BorderBrush" Value="#C9D9F8"/><Setter Property="Foreground" Value="#174FAC"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppAccent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
    <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{DynamicResource AppInk}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppLine}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFD"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF5"/>
    <Setter Property="RowHeight" Value="36"/><Setter Property="ColumnHeaderHeight" Value="42"/>
    <Setter Property="RowHeaderWidth" Value="0"/><Setter Property="MinColumnWidth" Value="90"/>
    <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
  </Style>
  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
    <Setter Property="Background" Value="#EEF3FA"/><Setter Property="Foreground" Value="#445B77"/>
    <Setter Property="Padding" Value="12,9"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppLine}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
    <Setter Property="Padding" Value="10,4"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E8F0FF"/><Setter Property="Foreground" Value="#173E7D"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AppAccent}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="AmountCell" TargetType="TextBlock">
    <Setter Property="TextAlignment" Value="Right"/><Setter Property="Padding" Value="4,0,10,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <Style x:Key="AmountEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="TextAlignment" Value="Right"/><Setter Property="Padding" Value="6,2,10,2"/>
    <Setter Property="MinHeight" Value="28"/><Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <Style x:Key="VoucherStatusCell" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#645224"/><Setter Property="Background" Value="#FFF5DB"/>
    <Setter Property="Padding" Value="8,3"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="Text" Value="已记账"><Setter Property="Foreground" Value="#22684B"/><Setter Property="Background" Value="#E8F5EE"/></Trigger>
      <Trigger Property="Text" Value="已审核"><Setter Property="Foreground" Value="#2459A6"/><Setter Property="Background" Value="#EAF1FF"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="StatusBar" BasedOn="{StaticResource {x:Type StatusBar}}">
    <Setter Property="Background" Value="White"/><Setter Property="Padding" Value="20,5"/>
    <Setter Property="Foreground" Value="{DynamicResource AppMuted}"/><Setter Property="FontSize" Value="12"/>
  </Style>
</ResourceDictionary>
