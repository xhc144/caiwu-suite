<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Caiwu.Desktop.MainWindow" Title="财务套件 · 开发预览" Width="1280" Height="840" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style x:Key="AmountCell" TargetType="TextBlock">
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Padding" Value="4,0,8,0" />
    </Style>
  </Window.Resources>
  <DockPanel Background="#F3F6FA">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="新建账套…" Click="NewBook_Click" InputGestureText="Ctrl+Shift+N" />
        <MenuItem Header="打开账套…" Click="OpenBook_Click" InputGestureText="Ctrl+O" />
        <MenuItem Header="关闭账套" Click="CloseBook_Click" />
        <Separator />
        <MenuItem Header="备份当前账套…" Click="Backup_Click" InputGestureText="F10" />
        <MenuItem Header="从备份恢复副本…" Click="Restore_Click" />
        <Separator />
        <MenuItem Header="退出" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="实务操作(_B)">
        <MenuItem Header="新增凭证" Click="NewVoucher_Click" Tag="WriteOperation" InputGestureText="Ctrl+N" />
        <MenuItem Header="凭证序时簿" Click="VoucherPage_Click" />
        <MenuItem Header="科目余额表" Click="TrialPage_Click" />
        <MenuItem Header="明细分类账" Click="LedgerPage_Click" />
        <Separator />
        <MenuItem Header="月度结账…" Click="CloseMonth_Click" Tag="WriteOperation" />
      </MenuItem>
      <MenuItem Header="会计档案(_A)">
        <MenuItem Header="会计科目" Click="AccountPage_Click" />
        <MenuItem Header="期初余额" Click="OpeningPage_Click" />
      </MenuItem>
      <MenuItem Header="报表(_R)">
        <MenuItem Header="账簿报表与导出…" Click="ReportCenter_Click" />
      </MenuItem>
      <MenuItem Header="系统管理(_S)">
        <MenuItem Header="账套信息" Click="BookInfo_Click" />
        <MenuItem Header="操作日志" Click="AuditPage_Click" />
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="本版范围与快捷键" Click="About_Click" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE5EE" BorderThickness="0,0,0,1" Padding="20,15">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="当前操作员" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox x:Name="OperatorInput" IsEditable="True" Width="125" Text="制单员" Margin="0,0,15,0">
            <ComboBoxItem Content="制单员" />
            <ComboBoxItem Content="审核员" />
          </ComboBox>
          <Button Content="新建账套" Click="NewBook_Click" />
          <Button Content="打开账套" Click="OpenBook_Click" />
        </StackPanel>
        <StackPanel>
          <TextBlock x:Name="BookNameText" Text="财务工作台" FontSize="22" FontWeight="SemiBold" Foreground="#173F61" />
          <TextBlock x:Name="BookSubtitleText" Text="现代界面 · 熟悉的账务流程" Foreground="#52697F" Margin="0,5,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom" Background="White">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="请选择账套" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem Content="开发预览 · 尚未完成生产账务验收" />
    </StatusBar>
    <Border DockPanel.Dock="Bottom" Background="#EDF3F8" Padding="20,9">
      <TextBlock x:Name="NotificationText" Text="Ctrl+N 新增凭证 · F4 科目查找 · F7 平衡复制 · F10 备份" TextWrapping="Wrap" Foreground="#405C73" />
    </Border>
    <Grid Margin="18">
      <Border x:Name="WelcomePanel" Background="White" CornerRadius="8" BorderBrush="#DCE5EE" BorderThickness="1" Padding="32">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="从一套真实账开始" FontSize="28" FontWeight="SemiBold" Foreground="#173F61" />
          <TextBlock Text="建立独立账套、录入期初和凭证，审核记账后查看余额与明细。数据保存在本机。" TextWrapping="Wrap" FontSize="15" Margin="0,14,0,22" />
          <StackPanel Orientation="Horizontal">
            <Button Content="新建账套…" Click="NewBook_Click" />
            <Button Content="打开已有账套…" Click="OpenBook_Click" />
          </StackPanel>
          <TextBlock x:Name="BackendNoticeText" Text="试用前请使用虚拟样例。原账套迁移和完整制度覆盖仍须独立验收。" TextWrapping="Wrap" Margin="0,24,0,16" />
          <Button Content="从备份恢复副本…" Click="Restore_Click" />
        </StackPanel>
      </Border>
      <TabControl x:Name="Pages" Visibility="Collapsed" SelectionChanged="Pages_SelectionChanged">
        <TabItem Header="工作台">
          <StackPanel Margin="24">
            <TextBlock Text="本期账务" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="OverviewText" Margin="0,12,0,18" FontSize="15" TextWrapping="Wrap" />
            <WrapPanel Margin="0,0,0,10">
              <Button Content="① 会计科目" Click="AccountPage_Click" />
              <Button Content="② 期初余额" Click="OpeningPage_Click" />
              <Button Content="③ 新增凭证" Click="NewVoucher_Click" Tag="WriteOperation" />
              <Button Content="④ 审核 / 记账" Click="VoucherPage_Click" />
              <Button Content="⑤ 余额与账簿" Click="TrialPage_Click" />
              <Button Content="⑥ 数据备份" Click="Backup_Click" />
            </WrapPanel>
            <TextBlock Text="凭证保存为草稿 → 更换为审核操作员审核 → 记账。已记账凭证只读，不能直接删除或修改。" TextWrapping="Wrap" Margin="0,22,0,12" />
            <TextBlock Text="余额表双击科目进入明细账；明细账双击分录查看凭证。结账前请核对并备份。" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="首版范围：单年度、人民币、基础账务。尚未提供完整财务报表、年结、税务、成本分配及原账套导入。" TextWrapping="Wrap" Foreground="#8C530A" />
          </StackPanel>
        </TabItem>
        <TabItem Header="凭证序时簿">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <WrapPanel Margin="0,0,0,10">
                <Button Content="新增 Ctrl+N" Click="NewVoucher_Click" Tag="WriteOperation" />
                <Button Content="查看 / 修改" Click="EditVoucher_Click" />
                <Button Content="审核 F4" Click="Review_Click" Tag="WriteOperation" />
                <Button Content="取消审核" Click="CancelReview_Click" Tag="WriteOperation" />
                <Button Content="记账" Click="Post_Click" Tag="WriteOperation" />
                <Button Content="删除草稿" Click="DeleteVoucher_Click" Tag="WriteOperation" />
                <Button Content="导出 CSV" Click="Export_Click" />
                <Button Content="导出 HTML" Click="ExportHtml_Click" />
                <Button Content="打印" Click="Print_Click" />
              </WrapPanel>
              <WrapPanel Margin="0,0,0,10">
                <DatePicker x:Name="VoucherFrom" Width="140" />
                <TextBlock Text=" 至 " VerticalAlignment="Center" />
                <DatePicker x:Name="VoucherTo" Width="140" Margin="0,0,12,0" />
                <ComboBox x:Name="VoucherStatusInput" Width="105" SelectedIndex="0" Margin="0,0,10,0">
                  <ComboBoxItem Content="全部状态" />
                  <ComboBoxItem Content="草稿" />
                  <ComboBoxItem Content="已审核" />
                  <ComboBoxItem Content="已记账" />
                </ComboBox>
                <TextBox x:Name="VoucherSearch" Width="180" ToolTip="摘要 / 编号 / 制单人" Margin="0,0,8,0" />
                <Button Content="查询" Click="Query_Click" />
              </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="VoucherCountText" DockPanel.Dock="Bottom" Margin="0,8,0,0" />
            <DataGrid x:Name="VoucherGrid" MouseDoubleClick="VoucherGrid_MouseDoubleClick" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="34" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F6F9FC" HeadersVisibility="Column" IsReadOnly="True" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="110" />
                <DataGridTextColumn Header="凭证号" Binding="{Binding Number}" Width="110" />
                <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" />
                <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=N2}" Width="140" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn Header="制单人" Binding="{Binding PreparedBy}" Width="95" />
                <DataGridTextColumn Header="审核人" Binding="{Binding ReviewedBy}" Width="95" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="会计科目">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <WrapPanel Margin="0,0,0,10">
                <Button Content="新增科目" Click="AddAccount_Click" Tag="WriteOperation" />
                <Button Content="新增明细" Click="AddChildAccount_Click" Tag="WriteOperation" />
                <Button Content="修改" Click="EditAccount_Click" Tag="WriteOperation" />
                <Button Content="删除" Click="DeleteAccount_Click" Tag="WriteOperation" />
                <Button Content="打印" Click="Print_Click" />
              </WrapPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="只有启用的末级明细科目可用于凭证。已有业务引用的科目不能直接删除。" Margin="0,10,0,0" />
            <DataGrid x:Name="AccountGrid" MouseDoubleClick="AccountGrid_MouseDoubleClick" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="34" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F6F9FC" HeadersVisibility="Column" IsReadOnly="True" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="150" />
                <DataGridTextColumn Header="科目名称" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="上级" Binding="{Binding Parent}" Width="130" />
                <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="80" />
                <DataGridTextColumn Header="层级" Binding="{Binding Level}" Width="80" />
                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="期初余额">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <WrapPanel Margin="0,0,0,10">
                <Button Content="保存期初余额" Click="SaveOpening_Click" Tag="WriteOperation" />
                <Button Content="重新载入" Click="ReloadOpening_Click" />
              </WrapPanel>
              <TextBlock Text="录入启用月份期初，仅列明细科目。期初修改受账务状态限制。" Margin="0,0,0,12" />
            </StackPanel>
            <TextBlock x:Name="OpeningTotalsText" DockPanel.Dock="Bottom" Margin="0,12,0,0" FontWeight="SemiBold" />
            <DataGrid x:Name="OpeningGrid" IsReadOnly="False" SelectionUnit="Cell" CellEditEnding="OpeningGrid_CellEditEnding" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" RowHeight="34" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F6F9FC" HeadersVisibility="Column" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="科目代码" Binding="{Binding Code}" Width="160" IsReadOnly="True" />
                <DataGridTextColumn Header="科目名称" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="借方期初" Binding="{Binding DebitText, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                <DataGridTextColumn Header="贷方期初" Binding="{Binding CreditText, UpdateSourceTrigger=PropertyChanged}" Width="200" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="科目余额表">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <WrapPanel Margin="0,0,0,10">
                <DatePicker x:Name="TrialFrom" Width="140" />
                <TextBlock Text=" 至 " VerticalAlignment="Center" />
                <DatePicker x:Name="TrialTo" Width="140" Margin="0,0,12,0" />
                <Button Content="查询" Click="Query_Click" />
                <Button Content="导出 CSV" Click="Export_Click" />
                <Button Content="导出 HTML" Click="ExportHtml_Click" />
                <Button Content="打印" Click="Print_Click" />
                <TextBlock Text="仅含已记账凭证 · 双击查看明细" VerticalAlignment="Center" Margin="8,0" />
              </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="TrialTotalsText" DockPanel.Dock="Bottom" Margin="0,12,0,0" FontWeight="SemiBold" />
            <DataGrid x:Name="TrialGrid" MouseDoubleClick="TrialGrid_MouseDoubleClick" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="34" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F6F9FC" HeadersVisibility="Column" IsReadOnly="True" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="代码" Binding="{Binding AccountCode}" Width="100" />
                <DataGridTextColumn Header="科目名称" Binding="{Binding AccountName}" Width="*" />
                <DataGridTextColumn Header="期初借方" Binding="{Binding OpeningDebit, StringFormat=N2}" Width="118" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="期初贷方" Binding="{Binding OpeningCredit, StringFormat=N2}" Width="118" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="本期借方" Binding="{Binding PeriodDebit, StringFormat=N2}" Width="118" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="本期贷方" Binding="{Binding PeriodCredit, StringFormat=N2}" Width="118" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="期末借方" Binding="{Binding ClosingDebit, StringFormat=N2}" Width="118" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="期末贷方" Binding="{Binding ClosingCredit, StringFormat=N2}" Width="118" ElementStyle="{StaticResource AmountCell}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="明细分类账">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <WrapPanel Margin="0,0,0,10">
                <ComboBox x:Name="LedgerAccountInput" Width="200" DisplayMemberPath="Name" SelectedValuePath="Code" Margin="0,0,10,0" />
                <DatePicker x:Name="LedgerFrom" Width="140" />
                <TextBlock Text=" 至 " VerticalAlignment="Center" />
                <DatePicker x:Name="LedgerTo" Width="140" Margin="0,0,12,0" />
                <Button Content="查询" Click="Query_Click" />
                <Button Content="返回余额表" Click="TrialPage_Click" />
                <Button Content="导出 CSV" Click="Export_Click" />
                <Button Content="导出 HTML" Click="ExportHtml_Click" />
                <Button Content="打印" Click="Print_Click" />
              </WrapPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="双击分录查看原凭证；已记账凭证只读。" Margin="0,12,0,0" />
            <DataGrid x:Name="LedgerGrid" MouseDoubleClick="LedgerGrid_MouseDoubleClick" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="34" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F6F9FC" HeadersVisibility="Column" IsReadOnly="True" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="110" />
                <DataGridTextColumn Header="凭证号" Binding="{Binding Number}" Width="110" />
                <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" />
                <DataGridTextColumn Header="借方" Binding="{Binding Debit, StringFormat=N2}" Width="135" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="贷方" Binding="{Binding Credit, StringFormat=N2}" Width="135" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="65" />
                <DataGridTextColumn Header="余额" Binding="{Binding Balance, StringFormat=N2}" Width="150" ElementStyle="{StaticResource AmountCell}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="操作日志">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="实际业务事件。首版操作员名称用于职责记录，不代表完整身份认证。" TextWrapping="Wrap" Margin="0,0,0,12" />
            </StackPanel>
            <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="34" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F6F9FC" HeadersVisibility="Column" IsReadOnly="True" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding At}" Width="230" />
                <DataGridTextColumn Header="操作员" Binding="{Binding OperatorName}" Width="100" />
                <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="150" />
                <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
