<Window x:Class="Caiwu.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="财务套件 · 开发预览" Width="1200" Height="800"
        MinWidth="1024" MinHeight="680" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <DockPanel Background="#F5F7FA">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件(_F)" />
      <MenuItem Header="实务操作(_B)" />
      <MenuItem Header="会计档案(_A)" />
      <MenuItem Header="系统管理(_S)" />
      <MenuItem Header="窗口(_W)" />
      <MenuItem Header="帮助(_H)" />
    </Menu>
    <StatusBar DockPanel.Dock="Bottom" Background="White">
      <StatusBarItem Content="尚未打开账套" />
      <Separator />
      <StatusBarItem Content="开发骨架 · 尚不能用于记账" />
    </StatusBar>
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,20">
        <TextBlock Text="财务工作台" FontSize="26" FontWeight="SemiBold" Foreground="#153C63" />
        <TextBlock Margin="0,8,0,0" Text="账套与凭证模块正在接入。此骨架尚不能保存或记账。" Foreground="#53677B" />
      </StackPanel>
      <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#DCE3EB" BorderThickness="1" Padding="20">
        <StackPanel>
          <TextBlock Text="先建立账套，再开始记账" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Margin="0,12,0,0" Text="计划流程：期初建账 → 凭证录入 → 审核记账 → 账簿联查 → 备份恢复" />
          <TextBlock Margin="0,16,0,0" Text="工作页将保留熟悉的菜单、表格和键盘操作；不显示演示余额或假报表。" Foreground="#53677B" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
