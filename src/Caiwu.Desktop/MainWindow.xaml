<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:Caiwu.Desktop.Shell.Wpf" x:Class="Caiwu.Desktop.MainWindow" Title="财务套件 · 开发预览" Width="1440" Height="920" MinWidth="1080" MinHeight="700" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
  <DockPanel Background="{DynamicResource AppCanvas}">
    <Menu x:Name="ShellMenuBar" DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{DynamicResource AppLine}" BorderThickness="0,1,0,1" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="当前操作员" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox x:Name="OperatorInput" IsEditable="True" Width="125" Text="制单员" Margin="0,0,15,0">
            <ComboBoxItem Content="制单员" />
            <ComboBoxItem Content="审核员" />
          </ComboBox>
          <TextBlock x:Name="OperationDateText" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <StackPanel>
          <TextBlock x:Name="BookNameText" Text="财务工作台" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AppInk}" />
          <TextBlock x:Name="BookSubtitleText" Text="原版结构升级 · 已接入基础账务" Foreground="{DynamicResource AppMuted}" Margin="0,5,0,0" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom" Background="White">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="请选择账套" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem Content="开发预览 · 尚未完成生产账务验收" />
    </StatusBar>
    <Border DockPanel.Dock="Bottom" Background="#E9EFF8" Padding="24,10">
      <TextBlock x:Name="NotificationText" Text="灰色入口为未完成；可用入口目前连接基础实现，完整原窗口与账套兼容仍待验收。" TextWrapping="Wrap" Foreground="#405C73" />
    </Border>
    <Grid Margin="8">
      <shell:MdiWorkspace x:Name="Workspace" Visibility="Collapsed"/>
      <Border x:Name="WelcomePanel" Background="White" CornerRadius="10" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" Padding="36">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="开始本期账务" FontSize="28" FontWeight="SemiBold" Foreground="#173F61" />
          <TextBlock Text="建立独立账套、录入期初和凭证，审核记账后查看余额与明细。数据保存在本机。" TextWrapping="Wrap" FontSize="15" Margin="0,14,0,22" />
          <StackPanel Orientation="Horizontal">
            <Button Content="新建账套…" Click="NewBook_Click" Style="{StaticResource PrimaryButton}" />
            <Button Content="打开已有账套…" Click="OpenBook_Click" />
          </StackPanel>
          <TextBlock x:Name="BackendNoticeText" Text="试用前请使用虚拟样例。原账套迁移和完整制度覆盖仍须独立验收。" TextWrapping="Wrap" Margin="0,24,0,16" />
          <Button Content="从备份恢复副本…" Click="Restore_Click" />
        </StackPanel>
      </Border>
      <TabControl x:Name="Pages" Visibility="Collapsed" SelectionChanged="Pages_SelectionChanged">
        <!-- Internal compatibility selection only; InitializeShell moves these contents into coexisting MDI sheets. -->
        <TabItem Header="工作台"><TextBlock x:Name="OverviewText" /></TabItem>
        <TabItem Header="凭证序时簿">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <WrapPanel Margin="0,0,0,10">
                <Button Content="新增 Ctrl+N" Style="{StaticResource PrimaryButton}" Click="NewVoucher_Click" Tag="WriteOperation" />
                <Button Content="查看 / 修改" Click="EditVoucher_Click" />
                <Button Content="审核 F4" Click="Review_Click" Tag="WriteOperation" />
                <Button Content="取消审核" Click="CancelReview_Click" Tag="WriteOperation" />
                <Button Content="记账" Click="Post_Click" Tag="WriteOperation" />
                <Button Content="删除草稿" Click="DeleteVoucher_Click" Tag="WriteOperation" />
                <Button Content="导出 CSV" Click="Export_Click" />
                <Button Content="导出 HTML" Click="ExportHtml_Click" />
                <Button Content="打印" Click="Print_Click" />
              </WrapPanel>
              <WrapPanel Margin="0,0,0,10">
                <DatePicker x:Name="VoucherFrom" Width="140" />
                <TextBlock Text=" 至 " VerticalAlignment="Center" />
                <DatePicker x:Name="VoucherTo" Width="140" Margin="0,0,12,0" />
                <ComboBox x:Name="VoucherStatusInput" Width="105" SelectedIndex="0" Margin="0,0,10,0">
                  <ComboBoxItem Content="全部状态" />
                  <ComboBoxItem Content="草稿" />
                  <ComboBoxItem Content="已审核" />
                  <ComboBoxItem Content="已记账" />
                </ComboBox>
                <TextBox x:Name="VoucherSearch" AutomationProperties.Name="搜索摘要、凭证编号或制单人" Width="200" ToolTip="摘要 / 编号 / 制单人" Margin="0,0,8,0" />
                <Button Content="查询" Style="{StaticResource PrimaryButton}" Click="Query_Click" />
              </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="VoucherCountText" DockPanel.Dock="Bottom" Margin="0,8,0,0" />
            <DataGrid x:Name="VoucherGrid" MouseDoubleClick="VoucherGrid_MouseDoubleClick" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="36" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFD" HeadersVisibility="Column" IsReadOnly="True" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="110" />
                <DataGridTextColumn Header="凭证号" Binding="{Binding Number}" Width="110" />
                <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" />
                <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=N2}" Width="140" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource VoucherStatusCell}" />
                <DataGridTextColumn Header="制单人" Binding="{Binding PreparedBy}" Width="95" />
                <DataGridTextColumn Header="审核人" Binding="{Binding ReviewedBy}" Width="95" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="会计科目">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <WrapPanel Margin="0,0,0,10">
                <Button Content="新增科目" Click="AddAccount_Click" Tag="WriteOperation" />
                <Button Content="新增明细" Click="AddChildAccount_Click" Tag="WriteOperation" />
                <Button Content="修改" Click="EditAccount_Click" Tag="WriteOperation" />
                <Button Content="删除" Click="DeleteAccount_Click" Tag="WriteOperation" />
                <Button Content="打印" Click="Print_Click" />
              </WrapPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="只有启用的末级明细科目可用于凭证。已有业务引用的科目不能直接删除。" Margin="0,10,0,0" />
            <DataGrid x:Name="AccountGrid" MouseDoubleClick="AccountGrid_MouseDoubleClick" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="36" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFD" HeadersVisibility="Column" IsReadOnly="True" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="150" />
                <DataGridTextColumn Header="科目名称" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="上级" Binding="{Binding Parent}" Width="130" />
                <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="80" />
                <DataGridTextColumn Header="层级" Binding="{Binding Level}" Width="80" />
                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="期初余额">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <WrapPanel Margin="0,0,0,10">
                <Button Content="保存期初余额" Style="{StaticResource PrimaryButton}" Click="SaveOpening_Click" Tag="WriteOperation" />
                <Button Content="重新载入" Click="ReloadOpening_Click" />
              </WrapPanel>
              <TextBlock Text="录入启用月份期初，仅列明细科目。期初修改受账务状态限制。" Margin="0,0,0,12" />
            </StackPanel>
            <TextBlock x:Name="OpeningTotalsText" DockPanel.Dock="Bottom" Margin="0,12,0,0" FontWeight="SemiBold" />
            <DataGrid x:Name="OpeningGrid" IsReadOnly="False" SelectionUnit="Cell" CellEditEnding="OpeningGrid_CellEditEnding" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" RowHeight="36" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFD" HeadersVisibility="Column" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="科目代码" Binding="{Binding Code}" Width="160" IsReadOnly="True" />
                <DataGridTextColumn Header="科目名称" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="借方期初" Binding="{Binding DebitText, UpdateSourceTrigger=PropertyChanged}" Width="200" ElementStyle="{StaticResource AmountCell}" EditingElementStyle="{StaticResource AmountEditor}" />
                <DataGridTextColumn Header="贷方期初" Binding="{Binding CreditText, UpdateSourceTrigger=PropertyChanged}" Width="200" ElementStyle="{StaticResource AmountCell}" EditingElementStyle="{StaticResource AmountEditor}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="科目余额表">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <WrapPanel Margin="0,0,0,10">
                <DatePicker x:Name="TrialFrom" Width="140" />
                <TextBlock Text=" 至 " VerticalAlignment="Center" />
                <DatePicker x:Name="TrialTo" Width="140" Margin="0,0,12,0" />
                <Button Content="查询" Style="{StaticResource PrimaryButton}" Click="Query_Click" />
                <Button Content="导出 CSV" Click="Export_Click" />
                <Button Content="导出 HTML" Click="ExportHtml_Click" />
                <Button Content="打印" Click="Print_Click" />
                <TextBlock Text="仅含已记账凭证 · 双击查看明细" VerticalAlignment="Center" Margin="8,0" />
              </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="TrialTotalsText" DockPanel.Dock="Bottom" Margin="0,12,0,0" FontWeight="SemiBold" />
            <DataGrid x:Name="TrialGrid" MouseDoubleClick="TrialGrid_MouseDoubleClick" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="36" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFD" HeadersVisibility="Column" IsReadOnly="True" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="代码" Binding="{Binding AccountCode}" Width="100" />
                <DataGridTextColumn Header="科目名称" Binding="{Binding AccountName}" Width="*" MinWidth="160" />
                <DataGridTextColumn Header="期初借方" Binding="{Binding OpeningDebit, StringFormat=N2}" Width="125" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="期初贷方" Binding="{Binding OpeningCredit, StringFormat=N2}" Width="118" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="本期借方" Binding="{Binding PeriodDebit, StringFormat=N2}" Width="118" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="本期贷方" Binding="{Binding PeriodCredit, StringFormat=N2}" Width="118" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="期末借方" Binding="{Binding ClosingDebit, StringFormat=N2}" Width="118" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="期末贷方" Binding="{Binding ClosingCredit, StringFormat=N2}" Width="118" ElementStyle="{StaticResource AmountCell}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="明细分类账">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <WrapPanel Margin="0,0,0,10">
                <ComboBox x:Name="LedgerAccountInput" Width="200" DisplayMemberPath="Name" SelectedValuePath="Code" Margin="0,0,10,0" />
                <DatePicker x:Name="LedgerFrom" Width="140" />
                <TextBlock Text=" 至 " VerticalAlignment="Center" />
                <DatePicker x:Name="LedgerTo" Width="140" Margin="0,0,12,0" />
                <Button Content="查询" Style="{StaticResource PrimaryButton}" Click="Query_Click" />
                <Button Content="返回余额表" Click="TrialPage_Click" />
                <Button Content="导出 CSV" Click="Export_Click" />
                <Button Content="导出 HTML" Click="ExportHtml_Click" />
                <Button Content="打印" Click="Print_Click" />
              </WrapPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="双击分录查看原凭证；已记账凭证只读。" Margin="0,12,0,0" />
            <DataGrid x:Name="LedgerGrid" MouseDoubleClick="LedgerGrid_MouseDoubleClick" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="36" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFD" HeadersVisibility="Column" IsReadOnly="True" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="110" />
                <DataGridTextColumn Header="凭证号" Binding="{Binding Number}" Width="110" />
                <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" />
                <DataGridTextColumn Header="借方" Binding="{Binding Debit, StringFormat=N2}" Width="135" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="贷方" Binding="{Binding Credit, StringFormat=N2}" Width="135" ElementStyle="{StaticResource AmountCell}" />
                <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="65" />
                <DataGridTextColumn Header="余额" Binding="{Binding Balance, StringFormat=N2}" Width="150" ElementStyle="{StaticResource AmountCell}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="操作日志">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="当前账套实际业务事件；操作员身份由已登录的本机账户核验，原逐菜单权限尚未接入。" TextWrapping="Wrap" Margin="0,0,0,12" />
            </StackPanel>
            <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="36" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFD" HeadersVisibility="Column" IsReadOnly="True" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding At}" Width="230" />
                <DataGridTextColumn Header="操作员" Binding="{Binding OperatorName}" Width="100" />
                <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="150" />
                <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
