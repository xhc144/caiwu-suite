<Window x:Class="Caiwu.Desktop.Dialogs.VoucherEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记账凭证" Width="1060" Height="710" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <DockPanel Margin="0,0,0,14">
        <Button DockPanel.Dock="Right" Content="打印" Click="Print_Click" Padding="16,7" Margin="8,0,0,0" />
        <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="保存并关闭  Ctrl+S" Click="Save_Click" Padding="16,7" />
        <StackPanel>
          <TextBlock Text="记账凭证" FontSize="26" FontWeight="SemiBold" Foreground="#174568" />
          <TextBlock x:Name="BookText" Margin="0,5,0,0" Foreground="#50667A" />
        </StackPanel>
      </DockPanel>
      <Border Background="#F0F5FA" CornerRadius="6" Padding="14" Margin="0,0,0,12">
        <WrapPanel VerticalAlignment="Center">
          <TextBlock Text="日期" VerticalAlignment="Center" Margin="0,0,8,0" />
          <DatePicker x:Name="DateInput" Width="145" Margin="0,0,20,0" />
          <TextBlock Text="类型" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="KindInput" Width="65" Margin="0,0,20,0" VerticalContentAlignment="Center" MaxLength="12" />
          <TextBlock Text="编号" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="NumberText" VerticalAlignment="Center" MinWidth="70" Margin="0,0,20,0" />
          <TextBlock Text="附单" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="AttachmentInput" Width="60" VerticalContentAlignment="Center" />
          <TextBlock Text=" 张" VerticalAlignment="Center" />
        </WrapPanel>
      </Border>
      <ToolBarTray Background="Transparent" Margin="0,0,0,8">
        <ToolBar>
          <Button x:Name="AddLineButton" Content="增加分录" Click="AddLine_Click" />
          <Button x:Name="RemoveLineButton" Content="删除分录" Click="RemoveLine_Click" />
          <Separator />
          <Button x:Name="PickAccountButton" Content="科目查找 F4" Click="PickAccount_Click" />
          <Button x:Name="BalanceButton" Content="平衡复制 F7" Click="Balance_Click" />
        </ToolBar>
      </ToolBarTray>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Border BorderBrush="#C9D8E5" BorderThickness="0,1,0,0" Padding="8,12">
        <DockPanel>
          <TextBlock x:Name="DifferenceText" DockPanel.Dock="Right" FontWeight="SemiBold" />
          <TextBlock x:Name="TotalsText" FontWeight="SemiBold" FontSize="15" />
        </DockPanel>
      </Border>
      <TextBlock x:Name="SignatureText" Foreground="#526779" Margin="8,2" />
      <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="8,6" />
      <TextBlock Text="Enter 下一格 · F4 查科目 · F7 复制上一行摘要并配平 · Ctrl+S 保存 · Esc 关闭" Foreground="#526779" Margin="8,6" />
    </StackPanel>
    <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
              CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="Cell"
              HeadersVisibility="Column" RowHeight="38" GridLinesVisibility="Horizontal"
              PreviewKeyDown="LinesGrid_PreviewKeyDown" SelectionChanged="LinesGrid_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="分录摘要" Binding="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
        <DataGridTextColumn Header="科目代码" Binding="{Binding AccountCode, UpdateSourceTrigger=PropertyChanged}" Width="125" />
        <DataGridTextColumn Header="科目名称" Binding="{Binding AccountName}" IsReadOnly="True" Width="1.4*" />
        <DataGridTextColumn Header="借方金额" Binding="{Binding DebitText, UpdateSourceTrigger=PropertyChanged}" Width="145" />
        <DataGridTextColumn Header="贷方金额" Binding="{Binding CreditText, UpdateSourceTrigger=PropertyChanged}" Width="145" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
