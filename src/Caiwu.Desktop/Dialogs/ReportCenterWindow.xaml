<Window x:Class="Caiwu.Desktop.Dialogs.ReportCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Caiwu.Desktop.Themes"
        Title="基础账务报表" Width="1220" Height="760" MinWidth="1020" MinHeight="620"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
  <Border Margin="20" Background="White" BorderBrush="{DynamicResource AppLine}" BorderThickness="1" CornerRadius="10" Padding="22">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="基础账务报表" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AppInk}" />
      <TextBlock Text="凭证与账簿数据输出。完整法定财务报表及报表设计器尚未开放。" Margin="0,6,0,16" Foreground="#53677B" />
      <WrapPanel Margin="0,0,0,12">
        <ComboBox x:Name="KindInput" Width="150" SelectedIndex="0" Margin="0,0,10,0">
          <ComboBoxItem Content="科目余额表"/><ComboBoxItem Content="明细分类账"/><ComboBoxItem Content="凭证清单"/>
        </ComboBox>
        <ComboBox x:Name="AccountInput" Width="205" DisplayMemberPath="Caption" SelectedValuePath="Code" Margin="0,0,10,0" />
        <DatePicker x:Name="FromInput" Width="145"/><TextBlock Text=" 至 " VerticalAlignment="Center"/><DatePicker x:Name="ToInput" Width="145" Margin="0,0,10,0"/>
        <Button Content="生成" Style="{StaticResource PrimaryButton}" Click="Generate_Click" Padding="14,6" />
      </WrapPanel>
      <WrapPanel Margin="0,0,0,12">
        <Button x:Name="BackButton" Content="返回余额表" Click="Back_Click" Visibility="Collapsed" Padding="14,6" Margin="0,0,8,0"/>
        <Button Content="导出 CSV" Click="ExportCsv_Click" Padding="14,6" Margin="0,0,8,0"/>
        <Button Content="导出分页 HTML" Click="ExportHtml_Click" Padding="14,6" Margin="0,0,8,0"/>
        <Button Content="Windows 打印" Click="Print_Click" Padding="14,6" Margin="0,0,16,0"/>
        <TextBlock Text="双击余额科目进入明细；双击发生分录查看凭证。" VerticalAlignment="Center" />
      </WrapPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="TotalText" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="NoteText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#53677B" />
      <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#B42318" />
    </StackPanel>
    <DataGrid x:Name="ReportGrid" themes:ReportGridPresentation.GroupAmounts="True" EnableColumnVirtualization="False" CellStyle="{StaticResource ReportCell}" RowHeight="36" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
              SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
              AlternatingRowBackground="#F4F8FB" MouseDoubleClick="ReportGrid_MouseDoubleClick" />
  </DockPanel>
  </Border>
</Window>
