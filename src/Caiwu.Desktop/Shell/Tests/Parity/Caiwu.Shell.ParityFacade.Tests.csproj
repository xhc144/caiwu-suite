<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><DefineConstants>$(DefineConstants);CAIWU_PARITY_MODULES</DefineConstants></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../Caiwu.Operators/Caiwu.Operators.csproj" />
    <Compile Include="../../../Presentation/PreviewLedgerService.cs" Link="PreviewLedgerService.cs" />
    <Compile Include="../../../Presentation/PreviewLedgerService.Parity.cs" Link="PreviewLedgerService.Parity.cs" />
  </ItemGroup>
  <Target Name="RequireRealParityContracts" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../../../Caiwu.Contracts/ParityModules.cs')" Text="Requires the integrator-owned ParityModules.cs checkpoint; do not substitute a local interface copy." />
  </Target>
</Project>
