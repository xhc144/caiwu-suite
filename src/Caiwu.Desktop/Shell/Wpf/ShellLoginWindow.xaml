<Window x:Class="Caiwu.Desktop.Shell.Wpf.ShellLoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="用户登录" Width="760" Height="510" MinWidth="700" MinHeight="470" WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Background="#F5F7FA" UseLayoutRounding="True">
 <Grid Margin="30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="用户登录" FontSize="25" FontWeight="SemiBold" Foreground="#173F61"/>
   <TextBlock Text="账套、用户与操作日期" Foreground="#516275" Margin="0,8,0,0"/></StackPanel>
  <Grid Grid.Row="1" Margin="70,22,35,15">
   <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <Label Content="套账名称" VerticalAlignment="Center" Target="{Binding ElementName=BookInput}"/>
   <ComboBox x:Name="BookInput" Grid.Column="1" DisplayMemberPath="Display" MinHeight="34" VerticalAlignment="Center" AutomationProperties.AutomationId="ParityLoginBook"/>
   <Button Grid.Column="2" Content="搜索" Margin="6,0,0,0" Click="Search_Click" VerticalAlignment="Center" AutomationProperties.AutomationId="ParityLoginSearch"/>
   <Label Grid.Row="1" Content="用户代码" VerticalAlignment="Center" Target="{Binding ElementName=UserInput}"/>
   <ComboBox x:Name="UserInput" Grid.Row="1" Grid.Column="1" IsEditable="True" MinHeight="34" VerticalAlignment="Center" AutomationProperties.AutomationId="ParityLoginUser"/>
   <Label Grid.Row="2" Content="用户密码" VerticalAlignment="Center" Target="{Binding ElementName=PasswordInput}"/>
   <PasswordBox x:Name="PasswordInput" Grid.Row="2" Grid.Column="1" MaxLength="128" MinHeight="34" VerticalAlignment="Center" AutomationProperties.AutomationId="ParityLoginPassword"/>
   <TextBlock Grid.Row="2" Grid.Column="2" Text="使用已设置的密码" TextWrapping="Wrap" Foreground="#516275" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
   <Label Grid.Row="3" Content="登录日期" VerticalAlignment="Center" Target="{Binding ElementName=DateInput}"/>
   <TextBox x:Name="DateInput" Grid.Row="3" Grid.Column="1" MaxLength="10" MinHeight="34" VerticalAlignment="Center" ToolTip="yyyy-MM-dd；用于本次操作，不自动替换为当天日期" AutomationProperties.AutomationId="ParityLoginDate"/>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="ErrorText" TextWrapping="Wrap" Foreground="#A33232" Margin="0,0,0,14" AutomationProperties.LiveSetting="Assertive"/>
  <StackPanel Grid.Row="3">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
    <Button x:Name="NewButton" Content="_N. 新增套账" Click="New_Click" MinWidth="120" Margin="0,0,20,0"/>
    <Button x:Name="ConfirmButton" Content="_Y. 确 认" Click="Confirm_Click" MinWidth="120" Margin="0,0,20,0"/>
    <Button Content="_E. 退 出" Click="Exit_Click" MinWidth="120"/>
   </StackPanel>
   <TextBlock Text="当前接入受管 .caiwu 账套与本机操作员；原版账套格式、账套代码和逐菜单授权尚未接入。" TextWrapping="Wrap" FontSize="12" Foreground="#735A26" Margin="0,18,0,0"/>
  </StackPanel>
 </Grid>
</Window>
