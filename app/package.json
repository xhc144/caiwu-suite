{
  "name": "caiwu-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen": "node scripts/gen-modules.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "pnpm gen && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "format": "prettier --check .",
    "fix": "prettier --write . && eslint . --fix",
    "test": "pnpm gen && vitest run",
    "test:watch": "pnpm gen && vitest",
    "build:web": "pnpm gen && pnpm -C apps/web build",
    "e2e": "pnpm build:web && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format && pnpm test && pnpm e2e",
    "desktop:build": "pnpm build:web && pnpm -C apps/desktop build",
    "desktop": "pnpm desktop:build && pnpm -C apps/desktop start"
  },
  "dependencies": {
    "@caiwu/core": "workspace:*",
    "@caiwu/db": "workspace:*",
    "@caiwu/server-kit": "workspace:*",
    "@caiwu/web-kit": "workspace:*",
    "@caiwu/ui": "workspace:*",
    "@caiwu/print": "workspace:*",
    "@caiwu/testkit": "workspace:*",
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.22",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "antd": "6.6.7",
    "better-sqlite3": "13.0.3",
    "dayjs": "1.11.23",
    "decimal.js": "10.6.0",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "kysely": "0.29.7",
    "pinyin-pro": "3.29.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
